MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 8190639984599874052}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e5b47bb31070dc84eba2f3398d8a26cb, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Gameplay.PedestrianChatter
  quietDuration: {x: 4, y: 10}
  lineDuration: 2.6
  sixSevenChance: 0.15
  sixSevenDuration: 3
  talkRadius: 5
  faceToFaceDist: 1.5
  approachTimeout: 10
  thoughts:
  - J'ai oublie d'eteindre le four ?
  - Belle journee pour marcher en rond.
  - Ou est-ce que j'allais deja...
  - J'aurais du prendre le bus.
  - Ce camion roule bizarrement, non ?
  - Croissant ou pain au chocolat...
  - Mes pieds me portent, mais vers quoi ?
  starters:
  - Salut ! Ca va ?
  - T'as vu ce camion ?!
  - Il va pleuvoir tu crois ?
  - Toujours a trainer ici toi !
  - T'as pas vu mon chat ?
  replies:
  - Ouais ouais, tranquille.
  - M'en parle pas !
  - Aucune idee, je fais que passer.
  - Ha ! Elle est bien bonne.
  - Faut que je file, a plus !
  - Si tu le dis...
